# Copy to terraform.tfvars and edit. Pass the password via the environment:
#   export TF_VAR_vsphere_password='...'

vsphere_server               = "vcenter.example.com"
vsphere_user                 = "terraform@vsphere.local"
vsphere_allow_unverified_ssl = false

datacenter = "DC1"
cluster    = "Cluster01"
datastore  = "datastore1"
folder     = "Linux"
template   = "rhel9-template"

vm_name = "app01"
domain  = "example.com"

# Sizing
cpu          = 4
memory_mb    = 8192
disk_size_gb = 60

# Networking: 2 NICs, one per port group
nic_count = 2
networks  = ["VM-Prod", "VM-Backup"]

# Static IP on NIC 0, DHCP on NIC 1. Omit entirely for DHCP everywhere.
ipv4_addresses = ["10.0.10.21", ""]
ipv4_netmask   = 24
ipv4_gateway   = "10.0.10.1"
dns_servers    = ["10.0.0.53", "10.0.0.54"]
